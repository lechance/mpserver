# 微信小程序（公众平台获取）
APPID=wx0000000000000000
APPSECRET=your_appsecret

# 服务
PORT=3000

# 单张图片大小上限（字节，默认 1M，微信 mediaCheckAsync 限制）
MAX_IMAGE_SIZE=1048576

# 本服务公网 HTTPS 地址（微信需能下载图片，即 media_url 前缀，必须可公网访问且为 443）
PUBLIC_BASE_URL=https://your-domain.example

# 微信「消息推送配置」中的 Token 与 EncodingAESKey（接收 mediaCheckAsync 异步结果必需）
WX_MSG_TOKEN=your_token
WX_MSG_ENCODING_AES_KEY=your_encoding_aes_key

# 检测场景（mediaCheckAsync scene：1 资料；2 评论；3 论坛；4 社交日志）
SEC_CHECK_SCENE=1

# 上传图片本地存储目录
UPLOAD_DIR=./uploads
