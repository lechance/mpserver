# 微信小程序（公众平台获取）
APPID=wx0000000000000000
APPSECRET=your_appsecret

# 服务
PORT=3000

# 单张图片大小上限（字节，默认 1M，微信 mediaCheckAsync 限制）
MAX_IMAGE_SIZE=1048576

# 本服务公网 HTTPS 地址（微信需能下载图片，即 media_url 前缀，必须可公网访问且为 443）
PUBLIC_BASE_URL=https://your-domain.example

# 微信「消息推送配置」中的 Token 与 EncodingAESKey（接收 mediaCheckAsync 异步结果必需）
WX_MSG_TOKEN=your_token
WX_MSG_ENCODING_AES_KEY=your_encoding_aes_key

# 检测场景（mediaCheckAsync scene：1 资料；2 评论；3 论坛；4 社交日志）
SEC_CHECK_SCENE=1

# 上传图片本地存储目录
UPLOAD_DIR=./uploads

# 调试模式（true 时打印请求日志与消息推送解密详情）
DEBUG=false

# 提交检测限流（每 IP 每窗口最多请求数）
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# 数据同步限流（每 IP 每窗口最多请求数，pull/push/delete 共用）
SYNC_RATE_LIMIT_MAX=30
SYNC_RATE_LIMIT_WINDOW_MS=60000

# 工具建议提交限流（每 IP 每窗口最多请求数）
SUGGEST_RATE_LIMIT_MAX=5
SUGGEST_RATE_LIMIT_WINDOW_MS=600000

# 管理后台登录限流（每 IP 每窗口最多尝试次数）
ADMIN_RATE_LIMIT_MAX=5
ADMIN_RATE_LIMIT_WINDOW_MS=900000

# 管理会话有效期（毫秒，默认 8 小时）
ADMIN_SESSION_EXPIRY_MS=28800000

# 管理后台令牌（访问 /admin 时需要）
ADMIN_TOKEN=your_admin_token
